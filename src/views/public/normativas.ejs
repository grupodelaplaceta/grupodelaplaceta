<section class="hero hero-sm">
  <h1>Normativa oficial del <span class="hl">BOP</span></h1>
  <p>Consulta la normativa vigente, subvenciones, bonos, programas y políticas publicadas por el Boletín Oficial de La Placeta.</p>
  <div class="hero-actions"><a href="https://bop.laplaceta.org/normativa" class="btn btn-go">Abrir BOP</a><a href="/junior/legal" class="btn btn-ol">Textos legales Junior</a></div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="bop-publico-heading"><div><h2>Normativa <span class="a">vigente</span></h2><p class="section-subtitle">Esta página consulta el catálogo oficial del BOP en tiempo real.</p></div><input id="filtroBop" class="input" style="max-width:300px" placeholder="Buscar por código o título…" aria-label="Buscar normativa"></div>
    <div id="catalogoBop" class="card-grid"><p class="bop-publico-loading">Cargando normativa…</p></div>
  </div>
</section>

<script>
  (async function () {
    const root = document.getElementById('catalogoBop');
    const filtro = document.getElementById('filtroBop');
    let docs = [];
    const esc = s => String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function pintar() {
      const q = filtro.value.toLowerCase().trim();
      const lista = docs.filter(d => `${d.codigo} ${d.titulo} ${d.tipo}`.toLowerCase().includes(q));
      root.innerHTML = lista.length ? lista.map(d => `<a class="card bop-publico-card" href="https://bop.laplaceta.org/documento?codigo=${encodeURIComponent(d.codigo)}"><span class="bop-publico-code">${esc(d.codigo)}</span><h3>${esc(d.titulo)}</h3><p>${esc(d.tipo || 'Normativa')} · versión ${esc(d.version || 1)}</p></a>`).join('') : '<p class="bop-publico-loading">No hay documentos que coincidan.</p>';
    }
    filtro.addEventListener('input', pintar);
    try { const r = await fetch('/api/normativa'); const payload = await r.json(); docs = (payload.documentos || []).filter(d => d.estado === 'vigente'); pintar(); }
    catch (_) { root.innerHTML = '<p class="bop-publico-loading">No se pudo cargar el catálogo del BOP.</p>'; }
  }());
</script>
