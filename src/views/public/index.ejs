<script>
  (() => {
    const render = document.querySelector('.junior-activity-render');
    if (!render) return;
    const main = render.querySelector('.junior-render-main img');
    const thumbs = [...render.querySelectorAll('.junior-render-thumbs img')];
    if (!main || thumbs.length < 2) return;
    let active = 0;
    const changeActivity = () => {
      active = (active + 1) % thumbs.length;
      main.classList.add('is-changing');
      window.setTimeout(() => {
        main.src = thumbs[active].src;
        main.alt = thumbs[active].alt;
        main.classList.remove('is-changing');
      }, 180);
      thumbs.forEach((thumb, index) => thumb.closest('figure')?.classList.toggle('is-active', index === active));
    };
    window.setInterval(changeActivity, 5000);
  })();
</script>
